# Moraí — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com as credenciais do seu projeto Supabase.
# Enquanto estas variáveis não forem preenchidas, o app funciona em modo demonstrativo
# com os 100 imóveis locais (src/lib/data/properties.json) e cadastros salvos só no dispositivo.

# Painel do projeto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Apenas para scripts locais (scripts/seed-supabase.mjs) — NUNCA exponha no client/.env público.
# Painel do projeto Supabase > Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
